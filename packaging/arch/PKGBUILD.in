# Maintainer: KWin AutoScroll contributors
# SPDX-License-Identifier: GPL-2.0-or-later

pkgname=kwin-autoscroll
pkgver=@VERSION@
pkgrel=2
pkgdesc='Windows-style middle-click continuous scrolling for KWin'
arch=('x86_64')
url='https://github.com/elecxyz/Kwin_AutoScroll'
license=('GPL-2.0-or-later')
depends=('kwin=@KWIN_VERSION@' 'gcc-libs' 'glibc' 'kcmutils' 'kconfig'
         'kcoreaddons' 'qt6-base' 'qt6-svg')
makedepends=('cmake' 'extra-cmake-modules' 'ninja' 'vulkan-headers')
checkdepends=('appstream')
source=("${pkgname}-${pkgver}.tar.xz")
sha256sums=('@SHA256@')

build() {
  cmake -S "${pkgname}-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${pkgname}-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

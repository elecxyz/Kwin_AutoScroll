        <file alias="styles/classic/direction.svg">assets/direction.svg</file>
        <file alias="styles/feather/anchor.svg">assets/feather-anchor.svg</file>
        <file alias="styles/feather/direction.svg">assets/feather-direction.svg</file>
        <file alias="styles/orbit/anchor.svg">assets/orbit-anchor.svg</file>
        <file alias="styles/orbit/direction.svg">assets/orbit-direction.svg</file>
        <file alias="styles/circuit/anchor.svg">assets/circuit-anchor.svg</file>

<ui version="4.0">
 <class>AutoScrollConfigForm</class>
 <widget class="QWidget" name="AutoScrollConfigForm">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="descriptionLabel">
     <property name="text">
      <string>Configure how pointer distance controls continuous scrolling.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="activationModifierLabel">
       <property name="text"><string>Activation modifier:</string></property>
       <property name="buddy"><cstring>kcfg_ActivationModifier</cstring></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QComboBox" name="kcfg_ActivationModifier">
       <property name="toolTip">
        <string>Hold the selected modifier while middle-clicking, then release both before moving the pointer. Plain middle-clicks pass through when a modifier is selected.</string>
       </property>
       <item><property name="text"><string>None (plain middle-click)</string></property></item>
       <item><property name="text"><string>Control</string></property></item>
       <item><property name="text"><string>Meta</string></property></item>
       <item><property name="text"><string>Alt</string></property></item>
       <item><property name="text"><string>Shift</string></property></item>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="activationBehaviorLabel">
       <property name="text"><string>Activation behavior:</string></property>
       <property name="buddy"><cstring>kcfg_HoldToScroll</cstring></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="kcfg_HoldToScroll">
       <property name="text"><string>Click and hold to auto-scroll</string></property>
       <property name="toolTip">
        <string>Keep the middle button held while scrolling. When an activation modifier is configured, release the modifier first; releasing the middle button stops AutoScroll.</string>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="deadZoneLabel">
       <property name="text"><string>Dead zone:</string></property>
       <property name="buddy"><cstring>kcfg_DeadZone</cstring></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="kcfg_DeadZone">
       <property name="suffix"><string> px</string></property>
       <property name="minimum"><number>4</number></property>
       <property name="maximum"><number>64</number></property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="maximumSpeedLabel">
       <property name="text"><string>Maximum speed:</string></property>
       <property name="buddy"><cstring>kcfg_MaximumSpeed</cstring></property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QSpinBox" name="kcfg_MaximumSpeed">
       <property name="suffix"><string> units/s</string></property>
       <property name="minimum"><number>200</number></property>
       <property name="maximum"><number>4000</number></property>
       <property name="singleStep"><number>100</number></property>
      </widget>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="accelerationLabel">
       <property name="text"><string>Acceleration curve:</string></property>
       <property name="buddy"><cstring>kcfg_AccelerationExponent</cstring></property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="QDoubleSpinBox" name="kcfg_AccelerationExponent">
       <property name="toolTip">
        <string>Higher values make scrolling gentler near the anchor and steeper farther away.</string>
       </property>
       <property name="decimals"><number>1</number></property>
       <property name="minimum"><double>0.500000000000000</double></property>
       <property name="maximum"><double>3.000000000000000</double></property>
       <property name="singleStep"><double>0.100000000000000</double></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
   <widget class="QCheckBox" name="kcfg_HorizontalScrolling">
     <property name="text"><string>Enable horizontal scrolling</string></property>
   </widget>
  </item>
   <item>
    <widget class="QGroupBox" name="excludedApplicationsGroupBox">
     <property name="title"><string>Excluded applications</string></property>
     <layout class="QVBoxLayout" name="excludedApplicationsLayout">
      <item>
       <widget class="AutoScroll::ApplicationExclusionsWidget" name="kcfg_ExcludedApplications"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_VisualFeedback">
     <property name="text"><string>Show the anchor and directional cursor</string></property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="appearanceGroupBox">
     <property name="enabled"><bool>false</bool></property>
     <property name="title"><string>Visual appearance</string></property>
     <layout class="QHBoxLayout" name="appearanceLayout">
      <item alignment="Qt::AlignVCenter">
       <widget class="QLabel" name="glyphStyleLabel">
        <property name="text"><string>Pointer style:</string></property>
        <property name="buddy"><cstring>kcfg_GlyphStyle</cstring></property>
       </widget>
      </item>
      <item alignment="Qt::AlignVCenter">
       <widget class="AutoScroll::GlyphStyleComboBox" name="kcfg_GlyphStyle"/>
      </item>
      <item alignment="Qt::AlignVCenter">
       <widget class="AutoScroll::GlyphSizeComboBox" name="kcfg_GlyphSize"/>
      </item>
      <item>
       <spacer name="appearanceHorizontalSpacer">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
        <property name="sizeHint" stdset="0">
         <size><width>40</width><height>20</height></size>
        </property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0">
      <size><width>20</width><height>40</height></size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>AutoScroll::ApplicationExclusionsWidget</class>
   <extends>QWidget</extends>
   <header>applicationexclusionswidget.h</header>
  </customwidget>
  <customwidget>
   <class>AutoScroll::GlyphStyleComboBox</class>
   <extends>QComboBox</extends>
   <header>glyphselectors.h</header>
  </customwidget>
  <customwidget>
   <class>AutoScroll::GlyphSizeComboBox</class>
   <extends>QComboBox</extends>
   <header>glyphselectors.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections>
  <connection>
   <sender>kcfg_VisualFeedback</sender>
   <signal>toggled(bool)</signal>
   <receiver>appearanceGroupBox</receiver>
   <slot>setEnabled(bool)</slot>
   <hints>
    <hint type="sourcelabel"><x>154</x><y>247</y></hint>
    <hint type="destinationlabel"><x>154</x><y>309</y></hint>
   </hints>
  </connection>
 </connections>
</ui>

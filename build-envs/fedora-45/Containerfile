FROM registry.fedoraproject.org/fedora@sha256:ea0998f4c945b85c2134793cda4fac35ee394f0d677a04c5b1fe769e13f959b8

RUN dnf -y --setopt=install_weak_deps=False --setopt=keepcache=True install \
        appstream \
        binutils \
        cmake \
        cpio \
        extra-cmake-modules-6.31.0-1.fc45 \
        findutils \
        gcc-16.2.1-3.fc45 \
        gcc-c++-16.2.1-3.fc45 \
        glibc-2.44-2.fc45 \
        glibc-langpack-en \
        gzip \
        kf6-kcmutils-devel-6.31.0-1.fc45 \
        kf6-kconfig-devel-6.31.0-1.fc45 \
        kf6-kconfigwidgets-devel-6.31.0-1.fc45 \
        kf6-kcoreaddons-devel-6.31.0-1.fc45 \
        kf6-ki18n-devel-6.31.0-1.fc45 \
        kf6-kwidgetsaddons-devel-6.31.0-1.fc45 \
        kwin-6.8.2-3.fc45 \
        kwin-devel-6.8.2-3.fc45 \
        libdrm-devel \
        libepoxy-devel \
        ninja-build \
        pkgconf-pkg-config \
        qt6-qtbase-devel-6.11.2-3.fc45 \
        qt6-qtsvg-devel-6.11.2-1.fc45 \
        rpm-build \
        rpmdevtools \
        rpmlint \
        tar \
        vulkan-headers \
        xz \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' kwin)" = "6.8.2-3.fc45" \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' kwin-devel)" = "6.8.2-3.fc45" \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' qt6-qtbase-devel)" = "6.11.2-3.fc45" \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' extra-cmake-modules)" = "6.31.0-1.fc45"

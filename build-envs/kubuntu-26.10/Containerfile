FROM docker.io/library/ubuntu@sha256:1b798ba0017f24244ca02af25e3cfb1160db35e270e7b3beef708910b468bd92

COPY ubuntu.sources /tmp/ubuntu.sources

RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' \
        > /etc/apt/apt.conf.d/99keep-downloaded-packages \
    && sed 's#https://#http://#' /tmp/ubuntu.sources > /etc/apt/sources.list.d/ubuntu.sources \
    && rm -f /etc/apt/sources.list \
    && apt-get -qq update \
    && DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends ca-certificates \
    && install -m 0644 /tmp/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -qq update \
    && test "$(apt-cache policy kwin-dev | awk '/Candidate:/ {print $2}')" = "4:6.7.5-0ubuntu1" \
    && test "$(apt-cache policy kwin-wayland | awk '/Candidate:/ {print $2}')" = "4:6.7.5-0ubuntu1" \
    && (DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends \
        build-essential \
        cmake \
        debhelper \
        devscripts \
        dpkg-dev \
        extra-cmake-modules=6.29.0-0ubuntu1 \
        kwin-dev=4:6.7.5-0ubuntu1 \
        kwin-wayland=4:6.7.5-0ubuntu1 \
        libdrm-dev \
        libkf6config-dev=6.29.0-0ubuntu1 \
        libkf6configwidgets-dev=6.29.0-0ubuntu2 \
        libkf6coreaddons-dev=6.29.0-0ubuntu1 \
        libkf6i18n-dev=6.29.0-0ubuntu1 \
        libkf6kcmutils-dev=6.29.0-0ubuntu2 \
        libkf6widgetsaddons-dev=6.29.0-0ubuntu1 \
        lintian \
        ninja-build \
        pkgconf \
        qt6-base-dev=6.11.2+dfsg-4ubuntu2 \
        qt6-svg-dev=6.11.2-1 \
        libvulkan-dev > /tmp/builder-apt.log 2>&1 \
        || { tail -n 100 /tmp/builder-apt.log; exit 1; }) \
    && apt-cache policy kwin-dev kwin-wayland qt6-base-dev extra-cmake-modules
